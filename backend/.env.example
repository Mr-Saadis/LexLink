# ======================================================================
# LexLink Backend Environment Configuration
# ======================================================================

# Server
PORT=8000
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Embedding Model
# Options: BAAI/bge-m3 (1024-dim, default), all-MiniLM-L6-v2 (384-dim)
EMBEDDING_MODEL=BAAI/bge-m3

# Qdrant Vector Database
# Set QDRANT_URL to use Docker / Cloud Qdrant (e.g. http://localhost:6333)
# Leave empty to automatically use local embedded disk storage (qdrant_storage)
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_PATH=./qdrant_storage
QDRANT_COLLECTION=lexlink_judgments

# Supabase Database (PostgreSQL)
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
